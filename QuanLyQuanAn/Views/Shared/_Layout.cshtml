<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Quán Ăn</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyQuanAn.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        var taiKhoan = Context.Session.GetString("TaiKhoan");
        var vaiTro = Context.Session.GetString("VaiTro");

        bool isLayoutLoggedIn = !string.IsNullOrEmpty(taiKhoan);
        bool isAdmin = vaiTro == "Admin";
        bool isEmployee = vaiTro == "Employee";
    }
    <!-- Navbar Điều Hướng Hệ Thống -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid px-4">

                <!-- Logo / Thương hiệu -->
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-shop me-2" viewBox="0 0 16 16">
                        <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.371 2.371 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0M1.5 8.5A.5.5 0 0 1 2 9v6h1v-5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v5h6V9a.5.5 0 0 1 1 0v6h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1zM4 15h3v-5H4zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zm3 0h-2v3h2z" />
                    </svg>
                    QUẢN LÝ QUÁN ĂN
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Danh mục Menu chính -->
                <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium px-2" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium px-2" asp-controller="DonHang" asp-action="Index">Đơn hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium px-2" asp-controller="MonAn" asp-action="Index">Thực đơn</a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-2"
                                   asp-controller="NhanVien"
                                   asp-action="Index">
                                    Nhân viên
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-2"
                                   asp-controller="DanhMuc"
                                   asp-action="Index">
                                    Danh mục
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-2"
                                   asp-controller="Ban"
                                   asp-action="Index">
                                    Bàn ăn
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-2"
                                   asp-controller="ThongKe"
                                   asp-action="Index">
                                    Thống kê
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        @* <li class="nav-item">
                            <a class="nav-link text-muted small" asp-controller="Home" asp-action="Privacy">Bảo mật</a>
                        </li> *@

                        @* @{
                            

                            try
                            {
                                var hasSession = Context.Session != null && Context.Session.Keys.Contains("TaiKhoan");
                                var hasIdentity = User.Identity != null && User.Identity.IsAuthenticated;
                                var hasViewBag = ViewBag.VaiTro != null;

                                isLayoutLoggedIn = hasSession || hasIdentity || hasViewBag;
                            }
                            catch
                            {
                                isLayoutLoggedIn = (ViewBag.VaiTro != null) || (User.Identity != null && User.Identity.IsAuthenticated);
                            }
                        } *@

                        @if (isAdmin || isEmployee)
                        {
                            <!-- Hiển thị nút Đăng Xuất nếu đã đăng nhập -->
                            <li class="nav-item ms-2">
                                <a class="btn btn-outline-danger btn-sm px-3" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <!-- Hiển thị nút Đăng Nhập nếu chưa đăng nhập -->
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary btn-sm px-3 shadow-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Khung nội dung chính -->
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Chân trang (Footer) -->
    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container-fluid px-4 text-center text-md-start d-md-flex justify-content-between">
            <span>&copy; 2026 - Hệ thống Quản Lý Quán Ăn</span>
            @* <a class="text-decoration-none text-muted" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a> *@
        </div> 
    </footer>

    <!-- Các thư viện Script -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Script Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
