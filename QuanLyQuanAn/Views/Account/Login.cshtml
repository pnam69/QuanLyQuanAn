@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            
            <div class="card shadow-lg border-0 rounded-lg mt-4">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="text-center mb-4">
                        <!-- Icon Quán ăn -->
                        <div class="mb-3 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-shop" viewBox="0 0 16 16">
                                <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.371 2.371 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0M1.5 8.5A.5.5 0 0 1 2 9v6h1v-5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v5h6V9a.5.5 0 0 1 1 0v6h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1zM4 15h3v-5H4zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zm3 0h-2v3h2z"/>
                            </svg>
                        </div>
                        <h3 class="fw-bold text-uppercase mb-1">Quản Lý Quán Ăn</h3>
                        <p class="text-muted">Đăng nhập để vào hệ thống</p>
                    </div>

                    <form asp-action="Login" method="post">
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-4 rounded" role="alert"></div>

                        <!-- Trường Tài khoản -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">TÀI KHOẢN</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-person text-muted" viewBox="0 0 16 16">
                                      <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.5c0-.175-.243-.75-1.928-1.155C10.843 11.32 9.4 11 8 11s-2.843.32-4.072.845C2.243 12.25 2 12.825 2 13s.2.5 1 .5h10c.8 0 1-.3 1-.5"/>
                                    </svg>
                                </span>
                                <input type="text" name="TaiKhoan" class="form-control form-control-lg bg-light border-start-0 px-2" placeholder="Nhập mã NV hoặc username..." autocomplete="username" />
                            </div>
                            <span class="text-danger small mt-1 d-block">
                                @Html.ValidationMessage("TaiKhoan")
                            </span>
                        </div>

                        <!-- Trường Mật khẩu -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">MẬT KHẨU</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-lock text-muted" viewBox="0 0 16 16">
                                      <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
                                    </svg>
                                </span>
                                <input type="password" name="MatKhau" class="form-control form-control-lg bg-light border-start-0 px-2" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                            </div>
                            <span class="text-danger small mt-1 d-block">
                                @Html.ValidationMessage("MatKhau")
                            </span>
                        </div>

                        <!-- Nút Đăng nhập -->
                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm py-2">
                                ĐĂNG NHẬP
                            </button>
                        </div>
                        
                    </form>

                </div>
            </div>
            
            <div class="text-center mt-3">
                <p class="text-muted small">&copy; 2026 Hệ thống Quản lý Quán ăn</p>
            </div>

        </div>
    </div>
</div>