@model QuanLyQuanAn.Models.MonAn

@{
    ViewData["Title"] = "Xóa món ăn";
}

<h1>Xóa món ăn</h1>

<div class="alert alert-danger">
    Bạn có chắc chắn muốn xóa món ăn này không?
</div>

<dl class="row">
    <dt class="col-sm-3">
        Mã món
    </dt>

    <dd class="col-sm-9">
        @Model.MaMon
    </dd>

    <dt class="col-sm-3">
        Tên món
    </dt>

    <dd class="col-sm-9">
        @Model.TenMon
    </dd>

    <dt class="col-sm-3">
        Danh mục
    </dt>

    <dd class="col-sm-9">
        @Model.DanhMuc?.TenDM
    </dd>

    <dt class="col-sm-3">
        Đơn giá
    </dt>

    <dd class="col-sm-9">
        @Model.DonGia.ToString("N0") đ
    </dd>

    <dt class="col-sm-3">
        Trạng thái
    </dt>

    <dd class="col-sm-9">
        @Model.TrangThai
    </dd>
</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="MaMon" />

    <button type="submit"
            class="btn btn-danger">
        Xác nhận xóa
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Hủy
    </a>

</form>