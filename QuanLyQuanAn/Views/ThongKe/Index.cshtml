@{
    ViewData["Title"] = "Thống kê";

    var chiTietBanChay =
        ViewBag.ChiTietBanChay as IEnumerable<dynamic>
        ?? new List<dynamic>();

    var doanhThuTheoNgay =
        ViewBag.DoanhThuTheoNgay as IEnumerable<dynamic>
        ?? new List<dynamic>();
}

<h1>Thống kê</h1>

<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>

<form asp-action="Index"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-4">
        <label class="form-label">
            Từ ngày
        </label>

        <input type="date"
               name="tuNgay"
               value="@ViewBag.TuNgay"
               class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">
            Đến ngày
        </label>

        <input type="date"
               name="denNgay"
               value="@ViewBag.DenNgay"
               class="form-control" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit"
                class="btn btn-primary">
            Thống kê
        </button>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit"
                class="btn btn-primary me-2">
            Thống kê
        </button>

        <a asp-action="Export"
           asp-route-tuNgay="@ViewBag.TuNgay"
           asp-route-denNgay="@ViewBag.DenNgay"
           class="btn btn-success">
            Xuất Excel
        </a>

        <a asp-action="ExportPdf"
           asp-route-tuNgay="@ViewBag.TuNgay"
           asp-route-denNgay="@ViewBag.DenNgay"
           class="btn btn-danger">
            Xuất PDF
        </a>
    </div>

</form>

<div class="row g-3 mb-5">

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5>Tổng số đơn đã thanh toán</h5>

                <h2>
                    @ViewBag.TongDon
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5>Tổng doanh thu</h5>

                <h2>
                    @((decimal)ViewBag.TongDoanhThu) đ
                </h2>
            </div>
        </div>
    </div>

</div>

<h3>Món bán chạy</h3>

<table class="table table-bordered mb-5">
    <thead>
        <tr>
            <th>STT</th>
            <th>Món ăn</th>
            <th>Số lượng bán</th>
            <th>Doanh thu</th>
        </tr>
    </thead>

    <tbody>
        @{
            int stt = 1;
        }

        @foreach (var item in chiTietBanChay)
        {
            <tr>
                <td>@stt</td>
                <td>@item.TenMon</td>
                <td>@item.SoLuong</td>
                <td>
                    @item.DoanhThu.ToString("N0") đ
                </td>
            </tr>

            stt++;
        }

        @if (stt == 1)
        {
            <tr>
                <td colspan="4"
                    class="text-center">
                    Chưa có dữ liệu.
                </td>
            </tr>
        }
    </tbody>
</table>

<h3>Doanh thu theo ngày</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ngày</th>
            <th>Số đơn</th>
            <th>Doanh thu</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in doanhThuTheoNgay)
        {
            <tr>
                <td>
                    @item.Ngay.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @item.SoDon
                </td>

                <td>
                    @item.DoanhThu.ToString("N0") đ
                </td>
            </tr>
        }

        @if (!doanhThuTheoNgay.Any())
        {
            <tr>
                <td colspan="3"
                    class="text-center">
                    Chưa có dữ liệu.
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>
</div>