@model QuanLyQuanAn.Models.DanhMuc

@{
    ViewData["Title"] = "Thêm danh mục";
}

<h1>Thêm danh mục</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="TenDM" class="form-label">
            Tên danh mục
        </label>

        <input asp-for="TenDM" class="form-control" />

        <span asp-validation-for="TenDM"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MoTa" class="form-label">
            Mô tả
        </label>

        <textarea asp-for="MoTa"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>
            <input asp-for="TrangThai" />
            Hoạt động
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Thêm
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>

</form>