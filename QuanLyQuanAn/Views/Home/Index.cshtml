@{
    ViewData["Title"] = "Trang chủ";

    var hoTen = ViewBag.HoTen as string;
    var vaiTro = ViewBag.VaiTro as string;

    bool isLoggedIn = !string.IsNullOrEmpty(vaiTro);
    bool isAdmin = vaiTro == "Quản trị viên";
}

@if (!isLoggedIn)
{
    <div class="text-center mt-5">
        <h1>QUẢN LÝ QUÁN ĂN</h1>

        <p class="mt-3">
            Vui lòng đăng nhập để sử dụng hệ thống.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary">
            Đăng nhập
        </a>
    </div>

    return;
}

<div class="text-center mb-5">
    <h1>QUẢN LÝ QUÁN ĂN</h1>

    <p class="mt-3">
        Xin chào, <strong>@hoTen</strong>
    </p>

    <p>
        Vai trò: <strong>@vaiTro</strong>
    </p>
</div>

<div class="row g-3">

    @if (isAdmin)
    {
        <div class="col-md-4">
            <a asp-controller="NhanVien"
               asp-action="Index"
               class="btn btn-outline-primary w-100 p-4">
                Quản lý nhân viên
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="DanhMuc"
               asp-action="Index"
               class="btn btn-outline-primary w-100 p-4">
                Quản lý danh mục
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Ban"
               asp-action="Index"
               class="btn btn-outline-primary w-100 p-4">
                Quản lý bàn
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="ThongKe"
               asp-action="Index"
               class="btn btn-outline-primary w-100 p-4">
                Thống kê
            </a>
        </div>
    }

    <div class="col-md-4">
        <a asp-controller="MonAn"
           asp-action="Index"
           class="btn btn-outline-primary w-100 p-4">
            Quản lý món ăn
        </a>
    </div>

    

    <div class="col-md-4">
        <a asp-controller="DonHang"
           asp-action="Index"
           class="btn btn-outline-primary w-100 p-4">
            Quản lý đơn hàng
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Account"
           asp-action="Logout"
           class="btn btn-outline-danger w-100 p-4">
            Đăng xuất
        </a>
    </div>

</div>