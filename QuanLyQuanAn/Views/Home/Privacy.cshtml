@{
    ViewData["Title"] = "Chính sách bảo mật";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-sm border-0 rounded-lg">
                
                <!-- Tiêu đề Header -->
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                              <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.6.6 0 0 0 .388 0 2.4 2.4 0 0 0 .294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7.2 7.2 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.2 7.2 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                              <path d="M10.854 5.146a.5.5 0 0 1 0 .708-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                            </svg>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Chính Sách Bảo Mật</h4>
                            <small class="text-muted">Quy định về bảo vệ thông tin và dữ liệu hệ thống</small>
                        </div>
                    </div>
                </div>

                <!-- Nội dung chính -->
                <div class="card-body p-4 p-md-5">
                    <h5 class="fw-bold text-dark mb-3">1. Cam kết bảo mật thông tin</h5>
                    <p class="text-muted mb-4">
                        Hệ thống Quản lý Quán ăn cam kết bảo vệ tuyệt đối các thông tin cá nhân của Employee, dữ liệu đơn hàng, cũng như các số liệu kinh doanh nội bộ. Chúng tôi áp dụng các tiêu chuẩn bảo mật cao nhất để ngăn chặn tình trạng rò rỉ dữ liệu ra bên ngoài.
                    </p>

                    <h5 class="fw-bold text-dark mb-3">2. Thu thập và sử dụng dữ liệu</h5>
                    <p class="text-muted mb-4">
                        Các thông tin được thu thập trong quá trình vận hành (như thông tin tài khoản Employee, lịch sử gọi món, lịch sử giao dịch thanh toán) chỉ được sử dụng với mục đích duy nhất là phục vụ cho công tác quản lý, kiểm soát doanh thu và tối ưu hóa quy trình phục vụ khách hàng tại quán.
                    </p>

                    <h5 class="fw-bold text-dark mb-3">3. Phân quyền và bảo vệ tài khoản</h5>
                    <p class="text-muted mb-4">
                        Mỗi Employee và Admin được cấp một tài khoản định danh riêng biệt. Người dùng có trách nhiệm bảo quản mật khẩu cá nhân. Mọi thao tác thực hiện trên hệ thống dưới tên tài khoản nào sẽ được ghi nhận tương ứng với trách nhiệm của tài khoản đó.
                    </p>

                    <h5 class="fw-bold text-dark mb-3">4. Thay đổi chính sách</h5>
                    <p class="text-muted mb-4">
                        Chính sách bảo mật này có thể được cập nhật định kỳ để phù hợp với các tính năng mới của hệ thống quản lý. Mọi thay đổi sẽ được thông báo trực tiếp trên giao diện trang chủ của phần mềm.
                    </p>

                    <hr class="text-muted my-4" />

                    <!-- Nút điều hướng -->
                    <div class="text-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 shadow-sm">
                            Quay lại trang chủ
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>