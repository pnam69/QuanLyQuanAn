@{
    ViewData["Title"] = "Thêm món vào đơn hàng";

    var donHang = ViewBag.DonHang as QuanLyQuanAn.Models.DonHang;
    var monAns = ViewBag.MonAns as List<QuanLyQuanAn.Models.MonAn> ?? new List<QuanLyQuanAn.Models.MonAn>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <!-- Hiển thị thông báo lỗi nếu có -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                      <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0 rounded-lg">
                
                <!-- Tiêu đề Form -->
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded p-2 me-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cart-plus-fill" viewBox="0 0 16 16">
                              <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0M9 5.5V7h1.5a.5.5 0 0 1 0 1H9v1.5a.5.5 0 0 1-1 0V8H6.5a.5.5 0 0 1 0-1H8V5.5a.5.5 0 0 1 1 0"/>
                            </svg>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Thêm Món Mới</h4>
                            <small class="text-muted">Cập nhật thực đơn cho khách hàng</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    
                    <!-- Khối tóm tắt thông tin đơn hàng -->
                    <div class="bg-primary bg-opacity-10 rounded p-3 mb-4 border border-primary border-opacity-25 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-primary opacity-75 small fw-semibold d-block text-uppercase">Mã Đơn Hàng</span>
                            <span class="fw-bold text-primary fs-5">#@donHang?.MaDon</span>
                        </div>
                        <div class="text-end">
                            <span class="text-primary opacity-75 small fw-semibold d-block text-uppercase">Vị Trí Phục Vụ</span>
                            <span class="fw-bold text-dark fs-5">Bàn @donHang?.Ban?.SoBan</span>
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        
                        <input type="hidden" name="MaDon" value="@donHang?.MaDon" />

                        <!-- Input: Chọn Món Ăn -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">CHỌN MÓN ĂN</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cup-hot" viewBox="0 0 16 16">
                                      <path fill-rule="evenodd" d="M.5 6a.5.5 0 0 0-.488.608l1.652 7.434A2.5 2.5 0 0 0 4.104 16h5.792a2.5 2.5 0 0 0 2.44-1.958l.131-.59a3 3 0 0 0 1.3-5.854l.221-1.006A.5.5 0 0 0 13.5 6zM13 12.5a2.01 2.01 0 0 1-.316-.025l.867-3.924A2 2 0 0 1 13 12.5m-3.5 1.5a1.5 1.5 0 0 1-1.464 1.185H4.104A1.5 1.5 0 0 1 2.64 13.965l-1.51-6.796A.5.5 0 0 1 1.618 6.5h10.764a.5.5 0 0 1 .488.608z"/>
                                      <path d="M2.272 5.51a.5.5 0 0 1-.584-.427C1.536 2.061 2.89 0 5 0c.586 0 1.152.173 1.67.502.665.42 1.1 1.15 1.488 1.942.392.802.73 1.624 1.305 2.115.485.412 1.144.436 1.872.298a.5.5 0 1 1 .194.98c-.852.169-1.782.116-2.525-.516-.764-.648-1.154-1.593-1.564-2.433-.393-.804-.766-1.566-1.282-1.892C5.69 1.173 5.314 1 5 1c-1.636 0-2.617 1.517-3.151 3.925a.5.5 0 0 1-.423.435"/>
                                    </svg>
                                </span>
                                <select name="MaMon" class="form-select bg-light border-start-0" required>
                                    <option value="" selected disabled>-- Vui lòng chọn món --</option>
                                    @foreach (var mon in monAns)
                                    {
                                        <option value="@mon.MaMon">@mon.TenMon - @mon.DonGia.ToString("N0") đ</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Input: Số Lượng -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">SỐ LƯỢNG</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-123" viewBox="0 0 16 16">
                                      <path d="M2.873 11.297V4.142H1.699L0 5.379v1.137l1.64-1.18h.06v5.961h1.174Zm3.213-5.09v-.063c0-.618.44-1.169 1.196-1.169.678 0 1.174.44 1.174 1.106 0 .624-.42 1.101-.807 1.526L4.99 10.553v.744h4.78v-.99H6.643v-.069L8.41 8.252c.65-.724 1.237-1.332 1.237-2.27C9.646 4.849 8.723 4 7.308 4c-1.573 0-2.36 1.064-2.36 2.15v.057h1.138Zm6.559 1.883h.786c.823 0 1.374.481 1.379 1.179.01.734-.581 1.31-1.411 1.31-.807 0-1.355-.49-1.355-1.256h-1.17c0 1.336 1.086 2.304 2.525 2.304 1.418 0 2.578-.962 2.573-2.313-.005-1.115-.812-1.782-1.636-1.854v-.06c.749-.11 1.431-.76 1.431-1.784 0-1.216-1.04-2.025-2.365-2.025-1.33 0-2.361.809-2.361 2.025h1.17c0-.713.528-1.096 1.191-1.096.646 0 1.11.396 1.11 1.091 0 .72-.54 1.14-1.216 1.14h-.786v.99Z"/>
                                    </svg>
                                </span>
                                <input type="number" name="SoLuong" class="form-control bg-light border-start-0" value="1" min="1" required />
                            </div>
                        </div>

                        <hr class="text-muted my-4" />

                        <!-- Nút Điều Hướng & Submit -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="DonHang" asp-action="Details" asp-route-id="@donHang?.MaDon" class="btn btn-light border px-4">
                                Hủy
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1 mb-1" viewBox="0 0 16 16">
                                  <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                                </svg>
                                Thêm món này
                            </button>
                        </div>
                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>