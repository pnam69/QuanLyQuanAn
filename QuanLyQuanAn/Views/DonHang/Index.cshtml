@model IEnumerable<QuanLyQuanAn.Models.DonHang>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid mt-4">

    <!-- Thông báo lỗi/thành công -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
            </svg>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khối nội dung chính -->
    <div class="card shadow-sm border-0 rounded-lg">

        <!-- Header Card: Tiêu đề & Công cụ tìm kiếm -->
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="row align-items-center">

                <!-- Tiêu đề -->
                <div class="col-md-3 mb-3 mb-md-0 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-receipt" viewBox="0 0 16 16">
                            <path d="M1.92.506a.5.5 0 0 1 .434.14L3 1.293l.646-.647a.5.5 0 0 1 .708 0L5 1.293l.646-.647a.5.5 0 0 1 .708 0L7 1.293l.646-.647a.5.5 0 0 1 .708 0L9 1.293l.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .801.13l.5 1A.5.5 0 0 1 15 2v12a.5.5 0 0 1-.053.224l-.5 1a.5.5 0 0 1-.8.13L13 14.707l-.646.647a.5.5 0 0 1-.708 0L11 14.707l-.646.647a.5.5 0 0 1-.708 0L9 14.707l-.646.647a.5.5 0 0 1-.708 0L7 14.707l-.646.647a.5.5 0 0 1-.708 0L5 14.707l-.646.647a.5.5 0 0 1-.708 0L3 14.707l-.646.647a.5.5 0 0 1-.801-.13l-.5-1A.5.5 0 0 1 1 14V2a.5.5 0 0 1 .053-.224l-.5-1a.5.5 0 0 1 .367-.27m.217 1.338L2 2.118v11.764l.137.274.51-.51a.5.5 0 0 1 .707 0l.646.647.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.509.509.137-.274V2.118l-.137-.274-.51.51a.5.5 0 0 1-.707 0L12 1.707l-.646.647a.5.5 0 0 1-.708 0L10 1.707l-.646.647a.5.5 0 0 1-.708 0L8 1.707l-.646.647a.5.5 0 0 1-.708 0L6 1.707l-.646.647a.5.5 0 0 1-.708 0L4 1.707l-.646.647a.5.5 0 0 1-.708 0z" />
                        </svg>
                    </div>
                    <h4 class="fw-bold mb-0">Quản Lý Đơn Hàng</h4>
                </div>

                <!-- Form Tìm kiếm & Tạo mới -->
                <div class="col-md-9 text-md-end">
                    <form asp-action="Index" method="get" class="d-flex justify-content-md-end align-items-center gap-2 flex-wrap">

                        <div class="input-group shadow-sm" style="max-width: 400px; flex: 1;">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                </svg>
                            </span>
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 border-end-0" placeholder="Mã đơn, bàn, Employee, trạng thái..." />
                            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                            {
                                <a asp-action="Index" class="btn btn-light border border-start-0 text-secondary" title="Xóa tìm kiếm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                                        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                                    </svg>
                                </a>
                            }
                            <button type="submit" class="btn btn-primary px-3">Tìm</button>
                        </div>

                        <a asp-action="Create" class="btn btn-primary shadow-sm text-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" />
                            </svg>
                            Tạo đơn hàng
                        </a>

                    </form>
                </div>

            </div>
        </div>

        <!-- Bảng Dữ Liệu -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã Đơn</th>
                            <th>Vị Trí Bàn</th>
                            <th>Employee Phục Vụ</th>
                            <th>Thời Gian Lập</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#@item.MaDon</td>
                                    <td>
                                        <span class="fw-semibold">Bàn @item.Ban?.SoBan</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@item.NhanVien?.HoTen</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@item.NgayLap.ToString("HH:mm - dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-danger">@item.TongTien.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "Đã thanh toán")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">@item.TrangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <!-- Nút Xem Chi tiết -->
                                            <a asp-action="Details" asp-route-id="@item.MaDon" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13.13 13.13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.13 13.13 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5m0 2a.5.5 0 1 1 0 1 .5.5 0 0 1 0-1" />
                                                </svg>
                                            </a>

                                            <!-- Nút Xóa (Chỉ hiện khi chưa thanh toán) -->
                                            @if (item.TrangThai != "Đã thanh toán")
                                            {
                                                <form asp-action="Delete" asp-route-id="@item.MaDon" method="post" class="d-inline m-0" onsubmit="return confirm('Bạn có chắc muốn xóa đơn hàng này?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-0 rounded-end" title="Xóa đơn">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                                            <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                                                        </svg>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Trạng thái trống (Empty State) -->
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox mb-3 opacity-50" viewBox="0 0 16 16">
                                            <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zM3.81.563A1.5 1.5 0 0 1 4.98 0h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .106.311l-.04 9a1.5 1.5 0 0 1-1.5 1.5H1.54a1.5 1.5 0 0 1-1.5-1.5l-.04-9a.5.5 0 0 1 .106-.311zM2.146 9.027c0 .12-.006.239-.018.358l-.01.12c0 .034.004.068.01.103l.024.126.044.17c.1.332.298.544.59.544h10.428c.292 0 .49-.212.59-.544a.5.5 0 0 0 .044-.17.5.5 0 0 0 .01-.103l-.01-.12a.5.5 0 0 0-.018-.358c-.046-.508-.18-1.508-.18-1.508H10a1.5 1.5 0 0 1-1.5 1.5 1.5 1.5 0 0 1-1.5-1.5H2.326S2.19 8.52 2.146 9.027M14.54 8l-3.05-3.812A.5.5 0 0 0 11.02 4H4.98a.5.5 0 0 0-.39.188L1.54 8z" />
                                        </svg>
                                        <p class="mb-0">Không tìm thấy đơn hàng nào trong hệ thống!</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>