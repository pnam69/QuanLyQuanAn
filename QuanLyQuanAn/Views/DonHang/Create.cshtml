@{
    ViewData["Title"] = "Tạo đơn hàng";

    var nhanVien =
        ViewBag.NhanVien as QuanLyQuanAn.Models.NhanVien;

    var bans =
        ViewBag.Bans as List<QuanLyQuanAn.Models.Ban>
        ?? new List<QuanLyQuanAn.Models.Ban>();
}

<h1>Tạo đơn hàng</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label class="form-label">
            Nhân viên
        </label>

        <input type="text"
               class="form-control"
               value="@nhanVien?.HoTen"
               readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Bàn
        </label>

        <select name="MaBan"
                class="form-select"
                required>

            <option value="">
                -- Chọn bàn --
            </option>

            @foreach (var ban in bans)
            {
                <option value="@ban.MaBan">
                    Bàn @ban.SoBan - @ban.SoCho chỗ
                </option>
            }

        </select>

        <span class="text-danger">
            @Html.ValidationMessage("MaBan")
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Tạo đơn
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</form>