@{
    ViewData["Title"] = "Thanh toán hóa đơn";

    var donHang = ViewBag.DonHang as QuanLyQuanAn.Models.DonHang;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-lg">
                
                <!-- Tiêu đề Header -->
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded p-2 me-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16">
                              <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
                              <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2z"/>
                            </svg>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0 text-success">Thanh Toán Hóa Đơn</h4>
                            <small class="text-muted">Hoàn tất giao dịch và đóng bàn</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    
                    <!-- Thông báo lỗi nếu có -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                              <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                            </svg>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Khối tóm tắt thông tin đơn hàng -->
                    <div class="bg-light rounded p-4 mb-4 border">
                        <h6 class="fw-bold text-secondary mb-3 text-uppercase small">Tóm tắt đơn hàng</h6>
                        <ul class="list-group list-group-flush bg-transparent">
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 pt-0">
                                <span class="text-muted">Mã đơn hàng</span>
                                <span class="fw-bold text-primary">#@donHang?.MaDon</span>
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">Vị trí</span>
                                <span class="fw-semibold">Bàn @donHang?.Ban?.SoBan</span>
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 pb-0">
                                <span class="text-muted">Tổng tiền thanh toán</span>
                                <span class="fw-bold text-danger fs-4">@donHang?.TongTien.ToString("N0") đ</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Form Thanh Toán -->
                    <form asp-action="Create" method="post">
                        
                        <input type="hidden" name="MaDon" value="@donHang?.MaDon" />

                        <!-- Select: Phương thức thanh toán -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">PHƯƠNG THỨC THANH TOÁN</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-wallet2" viewBox="0 0 16 16">
                                      <path d="M12.5 3a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V4H3a.5.5 0 0 1-.5-.5h10zm-11 2a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-7z"/>
                                    </svg>
                                </span>
                                <select name="PhuongThuc" class="form-select bg-light border-start-0" required>
                                    <option value="" selected disabled>-- Chọn phương thức thanh toán --</option>
                                    <option value="Tiền mặt">Tiền mặt</option>
                                    <option value="Chuyển khoản">Chuyển khoản ngân hàng</option>
                                </select>
                            </div>
                        </div>

                        <hr class="text-muted my-4" />

                        <!-- Nút Điều Hướng & Submit -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="DonHang" asp-action="Details" asp-route-id="@donHang?.MaDon" class="btn btn-light border px-4">Quay lại</a>
                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check2-circle me-1 mb-1" viewBox="0 0 16 16">
                                  <path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0z"/>
                                  <path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0l7-7z"/>
                                </svg>
                                Xác nhận thanh toán
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>