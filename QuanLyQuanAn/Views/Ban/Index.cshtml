@model IEnumerable<QuanLyQuanAn.Models.Ban>

@{
    ViewData["Title"] = "Quản lý bàn";
}

<div class="container-fluid mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
            </svg>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-lg">

        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="row align-items-center">

                <div class="col-md-4 mb-3 mb-md-0 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-grid-3x3-gap-fill" viewBox="0 0 16 16">
                            <path d="M1 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zM1 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zM1 12a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z" />
                        </svg>
                    </div>
                    <h4 class="fw-bold mb-0">Quản Lý Bàn</h4>
                </div>

                <div class="col-md-8 text-md-end">
                    <form method="get" class="d-flex justify-content-md-end align-items-center gap-2 flex-wrap">

                        <select name="maTang"
                                asp-items="ViewBag.Tangs"
                                class="form-select shadow-sm"
                                style="max-width: 150px;"
                                onchange="this.form.submit()">
                        </select>

                        <div class="input-group shadow-sm" style="max-width: 300px;">
                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control bg-light border-end-0"
                                   placeholder="Nhập số bàn..." />

                            <button type="submit"
                                    class="btn btn-light border border-start-0 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16" height="16"
                                     fill="currentColor"
                                     viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                </svg>
                            </button>
                        </div>

                        <a asp-action="Create"
                           class="btn btn-primary shadow-sm text-nowrap">
                            Thêm bàn mới
                        </a>
                    </form>
                </div>

            </div>
        </div>

        @{
            var banList = Model?.ToList() ?? new List<Ban>();

            // Newly created tables may all have the default position (20,20).
            // Arrange them visually until the administrator saves their layout.
            bool useAutoLayout = banList.Count > 1 &&
                banList.Select(x => new { x.ViTriX, x.ViTriY })
                    .Distinct()
                    .Count() == 1;
        }

        <div class="card-body border-bottom">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                <div>
                    <h5 class="fw-bold mb-1">Sơ đồ bàn</h5>
                    <small class="text-muted">
                        Kéo bàn để thay đổi vị trí khi bật chế độ chỉnh sửa.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            id="btnEditLayout"
                            class="btn btn-outline-primary btn-sm">
                        Chỉnh sửa sơ đồ
                    </button>

                    <button type="button"
                            id="btnSaveLayout"
                            class="btn btn-success btn-sm"
                            disabled
                            style="display:none;">
                        Lưu vị trí
                    </button>

                    <button type="button"
                            id="btnCancelLayout"
                            class="btn btn-outline-secondary btn-sm"
                            disabled
                            style="display:none;">
                        Hủy
                    </button>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 mb-3 small">
                <span>
                    <span class="d-inline-block rounded-circle bg-success me-1"
                          style="width:10px;height:10px;"></span>
                    Trống
                </span>

                <span>
                    <span class="d-inline-block rounded-circle bg-warning me-1"
                          style="width:10px;height:10px;"></span>
                    Đã đặt
                </span>

                <span>
                    <span class="d-inline-block rounded-circle bg-danger me-1"
                          style="width:10px;height:10px;"></span>
                    Đang phục vụ
                </span>
            </div>

            
            @Html.AntiForgeryToken()

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button type="button" id="btnZoomOut" class="btn btn-outline-secondary btn-sm" title="Thu nhỏ">−</button>
                    <span id="zoomLevel" class="small text-muted" style="min-width:48px;text-align:center;">100%</span>
                    <button type="button" id="btnZoomIn" class="btn btn-outline-secondary btn-sm" title="Phóng to">+</button>
                    <button type="button" id="btnZoomFit" class="btn btn-outline-secondary btn-sm">Vừa màn hình</button>
                </div>

                <div class="d-flex flex-wrap gap-3 small align-items-center">
                    <span><span class="map-status-dot bg-success"></span> Trống</span>
                    <span><span class="map-status-dot bg-warning"></span> Đã đặt</span>
                    <span><span class="map-status-dot bg-danger"></span> Đang phục vụ</span>
                    <span><span class="map-status-dot bg-secondary"></span> Khác</span>
                </div>
            </div>
            <div class="map-editor-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="small fw-semibold me-1">Thêm vào sơ đồ:</span>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-add-object="counter">Quầy thu ngân</button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-add-object="window">Cửa sổ</button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-add-object="door">Cửa ra vào</button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-add-object="partition">Vách ngăn</button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-add-object="plant">Chậu cây</button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-add-object="decoration">Trang trí</button>

                <button type="button" class="btn btn-outline-danger btn-sm ms-auto"
                        id="btnDeleteMapObject" disabled>
                    Xóa đối tượng
                </button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        id="btnResetMapObjects">
                    Đặt lại nội thất
                </button>
            </div>
            <div class="table-map-wrapper">
                <div id="tableMap"
                     class="table-map"
                     data-floor-id="@Context.Request.Query["maTang"]"
                     data-save-positions-url="@Url.Action("SavePositions", "Ban")"
                     data-open-table-url="@Url.Action("OpenTable", "Ban")"
                     data-load-objects-url="@Url.Action("GetMapObjects", "Ban")"
                     data-save-objects-url="@Url.Action("SaveMapObjects", "Ban")">

                    <div class="map-wall map-wall-top"></div>
                    <div class="map-wall map-wall-right"></div>
                    <div class="map-wall map-wall-bottom"></div>
                    <div class="map-wall map-wall-left"></div>

                    <div id="mapEnvironment" class="map-environment"></div>

                    @for (var i = 0; i < banList.Count; i++)
                    {
                        var ban = banList[i];

                        var x = useAutoLayout
                            ? 8 + ((i % 5) * 17)
                            : ban.ViTriX;

                        var y = useAutoLayout
                            ? 12 + ((i / 5) * 22)
                            : ban.ViTriY;

                        <button type="button"
                            class="map-table"
                            data-id="@ban.MaBan"
                            data-name="@ban.SoBan"
                            data-capacity="@ban.SoCho"
                            data-status="@ban.TrangThai"
                            data-x="@x"
                            data-y="@y">

                            <span class="map-table-number">@ban.SoBan</span>
                            <span class="map-table-status">@ban.TrangThai</span>
                        </button>
                    }
                </div>
            </div>

            <div id="mapObjectProperties" class="map-object-properties mt-3" hidden>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <strong id="mapObjectTitle">Đối tượng được chọn</strong>
                    <span class="small text-muted">Có thể kéo trực tiếp trên sơ đồ</span>
                </div>

                <div class="row g-2">
                    <div class="col-6 col-md-2">
                        <label class="form-label small">Vị trí X (%)</label>
                        <input type="number" id="objectX" class="form-control form-control-sm"
                               min="0" max="100" step="0.5">
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small">Vị trí Y (%)</label>
                        <input type="number" id="objectY" class="form-control form-control-sm"
                               min="0" max="100" step="0.5">
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small">Chiều rộng (%)</label>
                        <input type="number" id="objectWidth" class="form-control form-control-sm"
                               min="2" max="100" step="0.5">
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small">Chiều cao (%)</label>
                        <input type="number" id="objectHeight" class="form-control form-control-sm"
                               min="2" max="100" step="0.5">
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small">Góc xoay</label>
                        <input type="number" id="objectRotation" class="form-control form-control-sm"
                               min="0" max="359" step="15">
                    </div>
                </div>
            </div>

            <div id="mapMessage" class="small mt-2" aria-live="polite"></div>

            <div id="tableInfo" class="border rounded p-3 mt-3" hidden>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="text-muted small">Thông tin bàn được chọn</div>
                        <h6 id="selectedTableName" class="fw-bold mb-1">—</h6>
                        <div class="small text-muted">
                            Sức chứa: <strong id="selectedTableCapacity">—</strong>
                            <span class="mx-2">|</span>
                            Trạng thái: <strong id="selectedTableStatus">—</strong>
                        </div>
                    </div>
                    <a id="btnOpenSelectedTable" class="btn btn-primary btn-sm" href="#">
                        Mở bàn
                    </a>
                </div>
            </div>

        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã Bàn</th>
                            <th>Số Bàn</th>
                            <th>Số Chỗ</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-semibold">#@item.MaBan</td>
                                    <td class="fw-bold text-primary">@item.SoBan</td>
                                    <td>@item.SoCho <span class="text-muted small">người</span></td>
                                    <td>
                                        @if (item.TrangThai == "Trống")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">@item.TrangThai</span>
                                        }
                                        else if (item.TrangThai == "Đã đặt")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning">@item.TrangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.MaBan" class="btn btn-sm btn-outline-primary" title="Sửa">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" />
                                                </svg>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaBan" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                                    <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                                                </svg>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox mb-3 opacity-50" viewBox="0 0 16 16">
                                            <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zM3.81.563A1.5 1.5 0 0 1 4.98 0h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .106.311l-.04 9a1.5 1.5 0 0 1-1.5 1.5H1.54a1.5 1.5 0 0 1-1.5-1.5l-.04-9a.5.5 0 0 1 .106-.311zM2.146 9.027c0 .12-.006.239-.018.358l-.01.12c0 .034.004.068.01.103l.024.126.044.17c.1.332.298.544.59.544h10.428c.292 0 .49-.212.59-.544a.5.5 0 0 0 .044-.17.5.5 0 0 0 .01-.103l-.01-.12a.5.5 0 0 0-.018-.358c-.046-.508-.18-1.508-.18-1.508H10a1.5 1.5 0 0 1-1.5 1.5 1.5 1.5 0 0 1-1.5-1.5H2.326S2.19 8.52 2.146 9.027M14.54 8l-3.05-3.812A.5.5 0 0 0 11.02 4H4.98a.5.5 0 0 0-.39.188L1.54 8z" />
                                        </svg>
                                        <p class="mb-0">Không tìm thấy dữ liệu bàn nào!</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/ban-map.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/ban-map.js"
            asp-append-version="true"></script>
}