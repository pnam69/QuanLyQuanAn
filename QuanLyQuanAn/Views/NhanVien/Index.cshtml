@model IEnumerable<QuanLyQuanAn.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý Employee";
}

<div class="container-fluid mt-4">

    <!-- Thông báo hệ thống (Success / Error) -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
              <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khối nội dung chính (Card Wrapper) -->
    <div class="card shadow-sm border-0 rounded-lg">
        
        <!-- Header Card: Tiêu đề & Công cụ tìm kiếm -->
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="row align-items-center">
                
                <!-- Tiêu đề -->
                <div class="col-md-4 mb-3 mb-md-0 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                          <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
                        </svg>
                    </div>
                    <h4 class="fw-bold mb-0">Quản Lý Employee</h4>
                </div>

                <!-- Form Tìm kiếm & Nút Thêm mới -->
                <div class="col-md-8 text-md-end">
                    <form method="get" class="d-flex justify-content-md-end align-items-center gap-2">
                        
                        <div class="input-group shadow-sm" style="max-width: 380px; flex: 1;">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                  <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                                </svg>
                            </span>
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 border-end-0" placeholder="Tên, tài khoản hoặc SĐT..." />
                            
                            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                            {
                                <a asp-action="Index" class="btn btn-light border border-start-0 text-secondary" title="Xóa tìm kiếm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                                      <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                                    </svg>
                                </a>
                            }
                            
                            <button type="submit" class="btn btn-primary px-3">Tìm</button>
                        </div>

                        <a asp-action="Create" class="btn btn-success shadow-sm text-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                            </svg>
                            Thêm Employee
                        </a>

                    </form>
                </div>

            </div>
        </div>

        <!-- Bảng Dữ Liệu -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã NV</th>
                            <th>Họ Tên</th>
                            <th>Số Điện Thoại</th>
                            <th>Email</th>
                            <th>Tài Khoản</th>
                            <th>Vai Trò</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-semibold">#@item.MaNV</td>
                                    
                                    <td class="fw-bold text-dark">@item.HoTen</td>
                                    
                                    <td>
                                        <span class="text-secondary">@(string.IsNullOrEmpty(item.SDT) ? "Chưa cập nhật" : item.SDT)</span>
                                    </td>
                                    
                                    <td>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(item.Email) ? "Chưa cập nhật" : item.Email)</span>
                                    </td>
                                    
                                    <td>
                                        <code>@item.TaiKhoan</code>
                                    </td>
                                    
                                    <td>
                                        @if (item.VaiTro == "Admin" || item.VaiTro == "Admin")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">@item.VaiTro</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">@item.VaiTro</span>
                                        }
                                    </td>
                                    
                                    <td>
                                        @if (item.TrangThai == "Hoạt động")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">@item.TrangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">@(string.IsNullOrEmpty(item.TrangThai) ? "Hoạt động" : item.TrangThai)</span>
                                        }
                                    </td>
                                    
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <!-- Nút Sửa -->
                                            <a asp-action="Edit" asp-route-id="@item.MaNV" class="btn btn-sm btn-outline-primary" title="Sửa">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                                  <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                </svg>
                                            </a>

                                            <!-- Nút Xóa -->
                                            <a asp-action="Delete" asp-route-id="@item.MaNV" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                                  <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5"/>
                                                </svg>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Trạng thái trống (Empty State) -->
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox mb-3 opacity-50" viewBox="0 0 16 16">
                                          <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zM3.81.563A1.5 1.5 0 0 1 4.98 0h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .106.311l-.04 9a1.5 1.5 0 0 1-1.5 1.5H1.54a1.5 1.5 0 0 1-1.5-1.5l-.04-9a.5.5 0 0 1 .106-.311zM2.146 9.027c0 .12-.006.239-.018.358l-.01.12c0 .034.004.068.01.103l.024.126.044.17c.1.332.298.544.59.544h10.428c.292 0 .49-.212.59-.544a.5.5 0 0 0 .044-.17.5.5 0 0 0 .01-.103l-.01-.12a.5.5 0 0 0-.018-.358c-.046-.508-.18-1.508-.18-1.508H10a1.5 1.5 0 0 1-1.5 1.5 1.5 1.5 0 0 1-1.5-1.5H2.326S2.19 8.52 2.146 9.027M14.54 8l-3.05-3.812A.5.5 0 0 0 11.02 4H4.98a.5.5 0 0 0-.39.188L1.54 8z"/>
                                        </svg>
                                        <p class="mb-0">Không tìm thấy Employee nào trong hệ thống!</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>