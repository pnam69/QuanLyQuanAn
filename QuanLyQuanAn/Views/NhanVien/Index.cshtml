@model IEnumerable<QuanLyQuanAn.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<h1>Quản lý nhân viên</h1>

<form method="get" class="mb-3">

    <input type="text"
           name="search"
           value="@ViewBag.Search"
           placeholder="Tên, tài khoản hoặc số điện thoại..."
           class="form-control"
           style="width: 300px; display: inline-block;" />

    <button type="submit"
            class="btn btn-primary">
        Tìm kiếm
    </button>

</form>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Thêm nhân viên
</a>

<table class="table">

    <thead>
        <tr>
            <th>Mã NV</th>
            <th>Họ tên</th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>Tài khoản</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.MaNV</td>

                <td>@item.HoTen</td>

                <td>@item.SDT</td>

                <td>@item.Email</td>

                <td>@item.TaiKhoan</td>

                <td>@item.VaiTro</td>

                <td>
                    @(item.TrangThai
                        ? "Hoạt động"
                        : "Ngừng hoạt động")
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.MaNV"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.MaNV"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>